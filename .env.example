# Private server-side connection to your Java Data Plane Gateway.
# Never use NEXT_PUBLIC_ for these settings.
GATEWAY_BASE_URL=http://127.0.0.1:8080
GATEWAY_API_KEY=replace-with-java-gateway-client-token
GATEWAY_MODEL=replace-with-configured-model-id
# Set to true for the zero-cost infrastructure pilot: disables POST /api/gateway/chat.
GATEWAY_PILOT_HEALTH_ONLY=true

# Single-operator MVP authentication. BOTH values are required to open /console.
# Replace with OIDC/SSO + organization-scoped RBAC before production.
DASHBOARD_ACCESS_PASSWORD=replace-with-a-long-random-operator-password
DASHBOARD_SESSION_SECRET=replace-with-a-separate-random-secret-minimum-32-characters
